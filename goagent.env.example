# GoAgent Environment Configuration Example

# Required for solo mode or dual Telegram bots: Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# LLM Configuration (OpenAI or any compatible provider like Ollama, Groq, OpenRouter, vLLM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional: Heavy model for escalation retries (default: empty / off)
# LLM_HEAVY_MODEL=gpt-4o

# Optional: Embedding configuration for Knowledge Base (RAG)
# LLM_EMBED_URL=https://api.openai.com/v1/embeddings
# LLM_EMBED_MODEL=text-embedding-3-small

# Mesh Cluster Mode ("solo", "leader", "worker", default: solo)
GOAGENT_ROLE=solo

# GoMesh Leader Configuration
# GOAGENT_MESH_LISTEN=:7801
# GOAGENT_MESH_TOKEN=your-mesh-auth-token-shared-across-cluster

# GoMesh Worker Configuration
# GOAGENT_LEADER_ADDR=http://127.0.0.1:7801
# GOAGENT_WORKER_ID=worker-node-1
# GOAGENT_CAPABILITIES=logs,files,shell
# GOAGENT_TASK_TIMEOUT=300
# GOAGENT_MISSION_TIMEOUT=1800

# Optional: Restrict bot usage to a specific Telegram Chat ID
# GOAGENT_ADMIN_CHAT_ID=123456789

# Optional: Allow unrestricted shell execution (default: false, only safe allowlist commands)
# GOAGENT_ALLOW_SHELL=false

# Optional: Maximum tool execution iterations per message (default: 8)
# GOAGENT_MAX_ITER=8

# Optional: Mask IPv4 addresses in outputs (default: false, logs keep exact IPs)
# GOAGENT_MASK_IP=false

# Optional: Colon-separated allowed file paths (default: cwd:/var/log:/tmp:~/Library/Logs:~/.goagent)
# GOAGENT_ALLOWED_ROOTS=.

# Optional: Allow reading .env files (default: false, blocked by guardrail)
# GOAGENT_ALLOW_ENV=false
