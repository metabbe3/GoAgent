# GoAgent Environment Configuration Example

# Required: Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# LLM Configuration (OpenAI or any compatible provider like Ollama, Groq, OpenRouter, LocalAI)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional: Restrict bot usage to a specific Telegram Chat ID
# GOAGENT_ADMIN_CHAT_ID=123456789

# Optional: Allow unrestricted shell execution (default: false, only safe allowlist commands)
# GOAGENT_ALLOW_SHELL=false

# Optional: Maximum tool execution iterations per message (default: 8)
# GOAGENT_MAX_ITER=8

# Optional: Mask IPv4 addresses in outputs (default: false, logs keep exact IPs)
# GOAGENT_MASK_IP=false

# Optional: Colon-separated allowed file paths (default: cwd:/var/log:/tmp:~/Library/Logs:~/.goagent)
# GOAGENT_ALLOWED_ROOTS=.

# Optional: Allow reading .env files (default: false, blocked by guardrail)
# GOAGENT_ALLOW_ENV=false
